# Required for run_pack. Get a key from the TypeSafe dashboard:
# https://console.typesafe.ai
TYPESAFE_API_KEY=

# Optional. Defaults to https://api.typesafe.ai (TypeSafe JS SDK).
# TYPESAFE_BASE_URL=

# Optional. Defaults to jev-latest (TypeSafe default model).
# Also honored: TYPESAFE_DEFAULT_MODEL
# JEV_MODEL=jev-latest
