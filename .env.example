# Optional local-shell reminder. The MCP server does NOT auto-load this file.
# The one-time user store is ~/.mcp_jev/.env (chmod 600), written by:
#   ./scripts/install.sh
#   node dist/index.js config set-key
#
# MCP host configs should stay keyless (command = ~/.mcp_jev/bin/mcp_jev).
# The user store (~/.mcp_jev/.env) wins. Process env is fallback only.

# Required for run_pack / run_questions. https://console.typesafe.ai
TYPESAFE_API_KEY=

# Optional. Defaults to https://api.typesafe.ai
# TYPESAFE_BASE_URL=

# Optional model. Precedence: JEV_MODEL > TYPESAFE_DEFAULT_MODEL > jev-latest
# JEV_MODEL=jev-latest
# TYPESAFE_DEFAULT_MODEL=jev-latest

# Optional path overrides for install/update scripts
# MCP_JEV_HOME=$HOME/.mcp_jev
# MCP_JEV_CONFIG=$HOME/.mcp_jev
# MCP_JEV_CHECKOUT=$HOME/mcp_jev
