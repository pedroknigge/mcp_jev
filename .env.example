# Required for run_pack. Get a key from the TypeSafe dashboard:
# https://console.typesafe.ai
#
# This file is NOT auto-loaded by mcp_jev. MCP hosts must set these
# variables in the server's `env` block. For a local shell only:
#   set -a && source .env && set +a
#   npm start
TYPESAFE_API_KEY=

# Optional. Defaults to https://api.typesafe.ai (TypeSafe JS SDK).
# TYPESAFE_BASE_URL=

# Optional model. Default: jev-latest
# Precedence: JEV_MODEL > TYPESAFE_DEFAULT_MODEL > jev-latest
# JEV_MODEL=jev-latest
# TYPESAFE_DEFAULT_MODEL=jev-latest
