{
  "name": "mcp_jev",
  "version": "0.1.0",
  "description": "Local MCP server for TypeSafe Jev (System One): run typed Choice / Noul / Score packs, not chat.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp_jev": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedroknigge/mcp_jev.git"
  },
  "homepage": "https://github.com/pedroknigge/mcp_jev#readme",
  "bugs": {
    "url": "https://github.com/pedroknigge/mcp_jev/issues"
  },
  "keywords": [
    "mcp",
    "jev",
    "typesafe",
    "system-one",
    "model-context-protocol"
  ],
  "license": "MIT",
  "author": "Pedro Knigge",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@typesafe-ai/sdk": "^0.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
